# Copy this file to .env and replace the placeholders. Do not commit .env.
AS_USERNAME=
AS_PASSWORD=

GAMEWORLDNAME: quimby
GAMEWORLDNAME_EXPORT_PROFILES: free1
# Optional: source and target airlines from the dashboard URL's ?select=<id> parameter.
AS_AIRLINE_ID=
AS_TARGET_AIRLINE_ID=

# Set these to the URLs for your AirlineSim game world. The service-profile URL
# can be copied directly from the browser while you are logged in.
AS_LOGIN_URL=https://your-game-world.airlinesim.aero/app/login
AS_SERVICE_PROFILES_URL=https://your-game-world.airlinesim.aero/app/service-profiles

